# Agent Flow Harness website (agentflowharness.com): static pages plus the installer and the
# auto-update feed (/downloads/latest.yml). Isolated site; other sites unchanged.
# Installed by scripts/deploy-website.ps1 to /etc/nginx/sites-available/afh-website; that script
# also gets the Let's Encrypt certificate the first time (webroot /var/www/afh, renewed by certbot).
#
# old.example.com, the first home, still serves /downloads/: apps built before the move update
# from it, and it is every app's fallback feed (desktop/main.js). Keep it.

# WebSocket upgrades for the relay (its own name, so it can't clash with another site's map)
map $http_upgrade $afh_connection {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name agentflowharness.com www.agentflowharness.com old.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/afh;
        default_type text/plain;
    }
    location / {
        return 301 https://agentflowharness.com$request_uri;
    }
}

# the old address: app updates keep working from it; everything else moves to the new domain
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name old.example.com;

    ssl_certificate     /etc/nginx/ssl/legacy.crt;
    ssl_certificate_key /etc/nginx/ssl/legacy.key;

    root  /var/www/afh;
    access_log /var/log/nginx/afh-website.access.log;

    location /downloads/ {
        location ~ \.yml$ {
            default_type text/yaml;
            add_header Cache-Control "no-cache" always;
        }
        location ~ \.(exe|blockmap)$ {
            add_header Cache-Control "public, max-age=86400" always;
        }
    }
    location / {
        return 301 https://agentflowharness.com$request_uri;
    }
}

# www → apex
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.agentflowharness.com;

    ssl_certificate     /etc/letsencrypt/live/agentflowharness.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentflowharness.com/privkey.pem;

    return 301 https://agentflowharness.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agentflowharness.com;

    ssl_certificate     /etc/letsencrypt/live/agentflowharness.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentflowharness.com/privkey.pem;

    root  /var/www/afh;
    index index.html;

    access_log /var/log/nginx/afh-website.access.log;
    error_log  /var/log/nginx/afh-website.error.log;

    client_max_body_size 16k;
    client_body_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    error_page 404 /404.html;

    # clean addresses: /features serves features.html
    location / {
        try_files $uri $uri.html $uri/ =404;
        # pages (and anything unversioned) are checked again on every visit
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # styles and scripts, versioned per deploy: the pages link /v/<stamp>/js/main.js, which is
    # /js/main.js — a new stamp each deploy, so these can be cached for good (deploy-website.ps1)
    location ~ ^/v/[0-9]+/((?:[\w-]+/)*[\w-]+\.(?:css|js))$ {
        alias /var/www/afh/$1;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /downloads/ {
        # latest.yml must never be stale, or apps miss a release
        location ~ \.yml$ {
            default_type text/yaml;
            add_header Cache-Control "no-cache" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
        # installers are immutable per version (and may be fetched in byte ranges)
        location ~ \.(exe|blockmap)$ {
            add_header Cache-Control "public, max-age=86400" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
    }

    # AFH accounts and remote access for the phone apps: relay/app.py on 127.0.0.1:8840
    # (afh-relay.service, scripts/deploy-relay.ps1). /relay/ is the account API and the computers'
    # WebSocket, /r/<computer>/ is AFH on that computer, /m/ is the phone sign-in and computer list.
    location ^~ /relay/ {
        proxy_pass http://127.0.0.1:8840;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $afh_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        client_max_body_size 25m;
        client_body_timeout 120s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location ^~ /r/ {
        proxy_pass http://127.0.0.1:8840;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $afh_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        client_max_body_size 25m;
        client_body_timeout 120s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /m { return 301 /m/; }
    location ^~ /m/ {
        proxy_pass http://127.0.0.1:8840;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $afh_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        client_max_body_size 25m;
        client_body_timeout 120s;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~ /\. {
        deny all;
    }
}
