# Agent Flow Harness website (agenflowharness.com): static pages plus the installer and the
# auto-update feed (/downloads/latest.yml). Isolated site; other sites unchanged.
# Installed by scripts/deploy-website.ps1 to /etc/nginx/sites-available/afh-website.
#
# Certificate: Let's Encrypt via certbot (webroot /var/www/afh), renewed by certbot's timer.
# Cloudflare proxies the site in "Full" SSL mode (it connects to port 443 here), so port 80 only
# answers Let's Encrypt's checks and sends everything else on to https.

server {
    listen 80;
    listen [::]:80;
    server_name agenflowharness.com www.agenflowharness.com old.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/afh;
        default_type text/plain;
    }
    location / {
        return 301 https://agenflowharness.com$request_uri;
    }
}

# the old address: app updates keep working from it; everything else moves to the new domain
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name old.example.com;

    ssl_certificate     /etc/nginx/ssl/legacy.crt;
    ssl_certificate_key /etc/nginx/ssl/legacy.key;

    root  /var/www/afh;
    access_log /var/log/nginx/afh-website.access.log;

    location /downloads/ {
        location ~ \.yml$ {
            default_type text/yaml;
            add_header Cache-Control "no-cache" always;
        }
        location ~ \.(exe|blockmap)$ {
            add_header Cache-Control "public, max-age=86400" always;
        }
    }
    location / {
        return 301 https://agenflowharness.com$request_uri;
    }
}

# www → apex
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.agenflowharness.com;

    ssl_certificate     /etc/letsencrypt/live/agenflowharness.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agenflowharness.com/privkey.pem;

    return 301 https://agenflowharness.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agenflowharness.com;

    ssl_certificate     /etc/letsencrypt/live/agenflowharness.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agenflowharness.com/privkey.pem;

    root  /var/www/afh;
    index index.html;

    access_log /var/log/nginx/afh-website.access.log;
    error_log  /var/log/nginx/afh-website.error.log;

    client_max_body_size 16k;
    client_body_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    error_page 404 /404.html;

    # clean addresses: /features serves features.html
    location / {
        try_files $uri $uri.html $uri/ =404;
        # pages (and anything unversioned) are checked again on every visit
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # styles and scripts, versioned per deploy: the pages link /v/<stamp>/js/main.js, which is
    # /js/main.js — a new stamp each deploy, so these can be cached for good (deploy-website.ps1)
    location ~ ^/v/[0-9]+/((?:[\w-]+/)*[\w-]+\.(?:css|js))$ {
        alias /var/www/afh/$1;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /downloads/ {
        # latest.yml must never be stale, or apps miss a release
        location ~ \.yml$ {
            default_type text/yaml;
            add_header Cache-Control "no-cache" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
        # installers are immutable per version (and may be fetched in byte ranges)
        location ~ \.(exe|blockmap)$ {
            add_header Cache-Control "public, max-age=86400" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
    }

    location ~ /\. {
        deny all;
    }
}
