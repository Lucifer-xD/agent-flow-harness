# AFH relay: accounts and remote access for the phone apps (relay/app.py), behind nginx at
# agentflowharness.com/relay/, /r/ and /m/. Installed by scripts/deploy-relay.ps1.
[Unit]
Description=AFH relay (accounts and remote access)
After=network.target

[Service]
User=afh-relay
Group=afh-relay
WorkingDirectory=/opt/afh-relay
Environment=AFH_RELAY_DB=/var/lib/afh-relay/relay.db
# the accounts that may open /admin: AFH_ADMINS=a@example.com,b@example.com in a file kept on the
# server only, and read access to the website's nginx log it counts from
EnvironmentFile=-/etc/afh-relay.env
SupplementaryGroups=adm
ExecStart=/opt/afh-relay/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8840 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/afh-relay

[Install]
WantedBy=multi-user.target
