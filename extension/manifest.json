{
  "manifest_version": 3,
  "name": "Agent Flow Harness",
  "short_name": "AFH",
  "version": "1.1.0",
  "description": "Lets the AFH agent work in this browser — your tabs and sign-ins — when you ask it to, in a tab group of its own.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Agent Flow Harness",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
