{
  "name": "agent-flow-harness",
  "productName": "Agent Flow Harness",
  "version": "1.25.0",
  "description": "Desktop shell for Agent Flow Harness (AFH), an open-source desktop coding agent.",
  "main": "main.js",
  "private": true,
  "author": "Agent Flow Harness contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "icon": "node ../scripts/make-placeholder-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.agentflowharness.app",
    "productName": "Agent Flow Harness",
    "artifactName": "AFH-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay-main.js",
      "browser-main.js",
      "overlay-preload.js",
      "overlay.html",
      "overlay.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/afh-backend",
        "to": "backend"
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "AFH-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Flow Harness",
      "artifactName": "AFH-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://agentflowharness.com/downloads/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
