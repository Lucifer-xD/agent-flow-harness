<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts, until Flutter draws its first frame -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Behind the Flutter UI while it runs -->
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/afh_bg</item>
    </style>
</resources>
